# Environment Configuration
NODE_ENV=development
PORT=3000

# Database Configuration
MONGODB_URI=mongodb+srv://DB_USER:REPLACE_WITH_URL_ENCODED_PASSWORD@CLUSTER_HOST/primeroute-cargos?retryWrites=true&w=majority

# JWT Configuration
JWT_SECRET=REPLACE_WITH_A_RANDOM_SECRET
JWT_EXPIRES_IN=7d
ADMIN_KEY=REPLACE_WITH_A_RANDOM_ADMIN_KEY

# CORS Configuration
CORS_ORIGIN=http://localhost:3000

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Never commit .env. Set MONGODB_URI, JWT_SECRET, and ADMIN_KEY in Render's
# Environment settings; render.yaml provides NODE_ENV, PORT, and CORS_ORIGIN.
